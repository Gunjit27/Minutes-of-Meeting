# Copy to .env and fill in. .env is gitignored.

# Answer LLM: "groq" (hosted, needs GROQ_API_KEY) or "ollama" (local llama3.1:8b)
LLM_PROVIDER=groq
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Embeddings: "hf" (in-process sentence-transformers) or "ollama" (nomic-embed-text)
EMBED_PROVIDER=hf
# HF_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Retrieval: vector | hybrid | hybrid_rerank
RETRIEVAL_MODE=hybrid_rerank

# DeepEval judge (evals only), runs on Groq
# JUDGE_MODEL=llama-3.3-70b-versatile
